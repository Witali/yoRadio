diff --git a/libfaad/packed_complex.h b/libfaad/packed_complex.h
new file mode 100644
--- /dev/null
+++ b/libfaad/packed_complex.h
@@ -0,0 +1,101 @@
+/*
+ * Experimental packed complex storage for memory-constrained fixed-point
+ * SBR/PS decoders.
+ *
+ * Layout:
+ *
+ *   31        28 27            14 13             0
+ *   +-----------+----------------+----------------+
+ *   | exponent  | signed Im[13:0]| signed Re[13:0]|
+ *   +-----------+----------------+----------------+
+ *
+ *   shift = exponent + 3      (3 .. 18)
+ *
+ * Persistent storage is 32 bits instead of two int32_t values (64 bits).
+ * DSP arithmetic remains native int32_t after unpacking.
+ */
+
+#ifndef __FAAD_PACKED_COMPLEX_H__
+#define __FAAD_PACKED_COMPLEX_H__
+
+#if !defined(FIXED_POINT)
+#error "packed_complex.h is only valid for FAAD2 FIXED_POINT builds"
+#endif
+
+typedef uint32_t packed_cplx32_t;
+
+/*
+ * Return the smallest exponent that makes both arithmetic-right-shifted
+ * components fit in signed 14 bits.
+ *
+ * For x < 0, x^(all-ones) produces |x|-1.  This exactly matches the
+ * asymmetric signed interval [-8192, +8191] after an arithmetic shift.
+ *
+ * The compare tree avoids relying on Zbb/CLZ.  This is useful on the
+ * baseline ESP32-C3 RV32IMC core.
+ */
+static INLINE uint8_t pcx_exp14(int32_t re, int32_t im)
+{
+    uint32_t ur = (uint32_t)re;
+    uint32_t ui = (uint32_t)im;
+    uint32_t u;
+    uint8_t e = 0;
+
+    ur ^= 0u - (ur >> 31);
+    ui ^= 0u - (ui >> 31);
+    u = (ur > ui) ? ur : ui;
+
+    if (u >= (1u << 23)) { u >>= 8; e += 8; }
+    if (u >= (1u << 19)) { u >>= 4; e += 4; }
+    if (u >= (1u << 17)) { u >>= 2; e += 2; }
+    if (u >= (1u << 16)) {           e += 1; }
+
+    return e;
+}
+
+/*
+ * Store the lower quantization-cell index.
+ *
+ * FAAD2 fixed-point code already assumes an arithmetic right shift for
+ * signed values.  GCC/Clang for ESP32-C3/RISC-V emit SRA/SRAI here.
+ */
+static INLINE packed_cplx32_t pcx_pack_complex(int32_t re, int32_t im)
+{
+    uint32_t e = pcx_exp14(re, im);
+    uint32_t shift = e + 3;
+    int32_t mr = re >> shift;
+    int32_t mi = im >> shift;
+
+    return (e << 28) |
+           (((uint32_t)mi & 0x3fffu) << 14) |
+           ((uint32_t)mr & 0x3fffu);
+}
+
+/*
+ * Branchless midpoint reconstruction.
+ *
+ * For m != 0:
+ *     reconstructed = m * 2^shift + 2^(shift-1)
+ *
+ * m == 0 is kept at exact zero.  This intentionally introduces a small
+ * zero dead-zone instead of turning stored zeros into a DC offset.
+ *
+ * Unsigned shifts are used for reconstruction so negative signed left
+ * shift never invokes C undefined behavior.
+ */
+static INLINE void pcx_unpack_complex(packed_cplx32_t p,
+                                      int32_t *re, int32_t *im)
+{
+    uint32_t e = p >> 28;
+    uint32_t shift = e + 3;
+    uint32_t half_shift = e + 2;
+    int32_t mr = ((int32_t)(p << 18)) >> 18;
+    int32_t mi = ((int32_t)(p << 4)) >> 18;
+
+    *re = (int32_t)(((uint32_t)mr << shift) +
+                    ((uint32_t)(mr != 0) << half_shift));
+    *im = (int32_t)(((uint32_t)mi << shift) +
+                    ((uint32_t)(mi != 0) << half_shift));
+}
+
+#endif /* __FAAD_PACKED_COMPLEX_H__ */
