"""Complete39 raw-channel numerical measurement against both recorded references; no processes."""
import argparse
import json
from pathlib import Path
import re
import sys

import mono_metrics
import pcm_metrics
import recorded_qualification as recorded
from capture39 import Inputs, capture, relative, sha
from policy39 import CASE_IDS, DECODERS, MAX_ABS_ERROR, bounded_policy, whole
from pcm_metrics import need

HERE = Path(__file__).resolve().parent


def transition_counts(pcm, case, offsets):
    channels = case['channels']
    need(channels in (1, 2) and len(offsets) == 15 and offsets[0] == 0 and offsets[-1] == len(pcm) and
         [b - a for a, b in zip(offsets, offsets[1:])] == case['pcm'], 'Full real-channel packet offsets required')
    result = {name: [0] * channels for name in ('SS', 'SL', 'LS', 'LL')}
    for packet in range(1, 14):
        name = 'SL'[case['modes'][packet - 1]] + 'SL'[case['modes'][packet]]
        first, stop = offsets[packet:packet + 2]
        for channel in range(channels):
            result[name][channel] += sum(pcm[i:i + 2] != b'\0\0' for i in range(first + 2 * channel, stop, channels * 2))
    return result


def run(args, result, save):
    inputs = Inputs()
    result['inputs'] = inputs.rows
    pins = json.loads(inputs.read('adapter/pins', HERE / 'numeric-pins.json'))
    for name, digest in pins['adapter_helpers'].items():
        inputs.read('adapter/' + name, HERE / name, digest)
    inputs.read('adapter/entrypoint', Path(__file__))
    prep_pin = pins['frozen_runtime_prep_readiness']
    inputs.read('runtime-prep/readiness', args.repository.resolve() / prep_pin['path'], prep_pin['sha256'])
    report, contract, captured, binding, mapping = capture(inputs, args, pins)
    repo = args.repository.resolve()
    refs = pins['reference']
    for name, row in refs.items():
        inputs.read('reference/proof/' + name, repo / row['path'], row['sha256'], row['bytes'])
    q = json.loads((repo / refs['qualification']['path']).read_bytes())
    host = json.loads((repo / refs['host']['path']).read_bytes())
    outer = json.loads((repo / refs['host_outer']['path']).read_bytes())
    qterminal = json.loads((repo / refs['qualification_terminal']['path']).read_bytes())
    matrix_raw = (repo / refs['comparison']['path']).read_bytes()
    matrix = json.loads(matrix_raw)
    need(matrix_raw == (repo / refs['host_matrix']['path']).read_bytes(), 'Canonical matrix must equal actual host origin bytes')
    recorded.terminal(outer, 0)
    recorded.terminal(qterminal, 0)
    need(q['profile'] == 'floorpresence39' and q['result'] == 'DUAL_REFERENCE_QUALIFIED' and
         all(q[k] is True for k in ('completed', 'reference_corpus_qualified', 'xiph_reference_qualified',
             'dual_reference_qualified', 'original_dual_reference_passed')) and
         all(q[k] is False for k in ('target_executed', 'production_changed', 'standard_conformance_qualified',
                                    'full_G6_qualified', 'physical_device')) and
         q['original_report_sha256'] == refs['host']['sha256'] and
         q['original_outer_receipt_sha256'] == refs['host_outer']['sha256'] and
         (q['xiph_cases'], q['native_compared'], q['native_lookup2_refusals'], q['paired_raw_packets'], q['expected_pcm_bytes']) ==
         (39, 39, 0, 546, 971520) and len(host['cases']) == len(q['cases']) == 39 and len(host['commands']) == 78 and
         host['completed'] is host['xiph_reference_qualified'] is host['dual_reference_qualified'] is True and
         host['failures'] == q['original_failures'] == [] and
         q['policy'] == dict(max_abs_error=2, predeclared=True, purpose='bounded-reference-crosscheck-not-standard-conformance'),
         'Exact actual39 dual-reference scope/policy/actual terminals required')
    need(q['validated_inputs']['qualifier/script']['sha256'] == pins['adapter_helpers']['recorded_qualification.py'] and
         outer['runner_sha256'] == qterminal['runner_sha256'] == pins['command_wrapper_sha256'], 'Recorded qualifier/wrapper identities')
    for role, row in q['validated_inputs'].items():
        inputs.read('reference/qualified/' + role, row['path'], row['sha256'], row['bytes'])
    for name, receipt in (('host', outer), ('qualifier', qterminal)):
        for path, row in receipt['logs'].items():
            inputs.read('reference/log/' + name + '/' + path, path, row['sha256'], row['bytes'])
    need(binding['schema'] == 'floor-presence39-recorded-dual-reference-binding-v1' and binding['completed'] is True and
         binding['contract_sha256'] == contract['contract_sha256'] and
         len(binding['cases']) == len(mapping['cases']) == len(matrix['cases']) == 39 and
         binding['dual_reference_passed'] is binding['actual_single_scope_reference_campaign_exists'] is True and
         binding['dual_reference_scope'] == 'only-floor-presence39-campaign' and
         binding['previous_unrelated_dual_NONPASS_reinterpreted'] is binding['target_executed'] is
         binding['target_numeric_comparison_performed'] is binding['full_G6_qualified'] is False and
         binding['new_reference_commands_executed'] is binding['aggregate_reference_campaign_exists'] is False and
         tuple(c['id'] for c in matrix['cases']) == CASE_IDS and
         mapping['original_cases_rewritten'] is False, 'Actual full39 raw/reference binding only')
    host_root = (repo / refs['host']['path']).parent
    commands = {row['name']: row for row in host['commands']}
    need(len(commands) == 78, 'Distinct complete78 reference child commands required')
    rows = []
    for index, (case, item, original, accepted, bound, origin, source) in enumerate(zip(
            contract['model']['cases'], captured, host['cases'], q['cases'], binding['cases'], mapping['cases'], matrix['cases'])):
        rid = '0-' + case['id']
        need(original['id'] == accepted['id'] == rid and original['input'] == source and
             original['source_matrix_sha256'] == refs['host_matrix']['sha256'] and
             Path(original['source_matrix']).resolve() == repo / refs['host_matrix']['path'] and
             origin['case'] == bound['case'] == index and origin['id'] == bound['id'] == source['id'] == case['id'] and
             origin['original_case_fields'] == origin['selected_case_fields'] == source and origin['fields_changed'] == [] and
             bound['raw_sha256'] == case['raw_sha256'] == {k: source['raw_sha256'][k] for k in ('identification', 'setup', 'audio')} and
             bound['channels'] == accepted['channels'] == source['channels'] == case['channels'] and
             bound['rate'] == accepted['rate'] == source['rate'] == case['rate'] and
             bound['frames'] == case['frames'] and bound['pcm_bytes'] == accepted['pcm_bytes'] == case['total_pcm'] and
             accepted['frames'] == case['frames'][1:] and accepted['bits'] == 16 and
             accepted['xiph_qualified'] is accepted['native_compared'] is True and accepted['native_lookup2_refusal'] is False and
             bound['qualification_sha256'] == refs['qualification']['sha256'] and bound['original_host_returncode'] == 0 and
             bound['original_reference_id'] == rid and bound['native_compared'] is True,
             'Every original raw/header/frame/actual-channel reference field must remain unchanged')
        for kind in ('identification', 'setup', 'audio', 'comment', 'ogg'):
            raw = inputs.read('reference/original-raw/' + rid + '/' + kind,
                (repo / refs['comparison']['path']).parent / source[kind],
                source['ogg_sha256'] if kind == 'ogg' else source['raw_sha256'][kind])
            for role in ('original', 'selected'):
                fact = origin['files'][kind][role]
                need(inputs.read('reference/mapped-raw/' + rid + '/' + kind + '/' + role,
                    fact['path'], fact['sha256'], fact['bytes']) == raw, 'Mapped original/selected raw bytes changed')
        metrics = mono_metrics if case['channels'] == 1 else pcm_metrics
        pcms, details, references = {}, {}, {}
        target_counts = transition_counts(item['pcm'], case, item['packet_offsets'])
        for decoder in DECODERS:
            command = commands['cases/' + rid + '/decode-' + decoder]
            receipt_path = host_root / relative(command['receipt'])
            receipt = json.loads(inputs.read('reference/child/' + rid + '/' + decoder, receipt_path, command['sha256']))
            recorded.terminal(receipt, 0)
            need(inputs.rows['reference/child/' + rid + '/' + decoder] == q['validated_inputs']['receipt/cases/' + rid + '/decode-' + decoder],
                 'Actual reference child receipt binding')
            wav = inputs.read('reference/WAV/' + rid + '/' + decoder, host_root / 'cases' / rid / (decoder + '.wav'),
                             original['decoded'][decoder]['wav_sha256'])
            md5path = host_root / 'cases' / rid / ('decode-' + decoder + '.stdout.log')
            md5fact = q['validated_inputs']['log/cases/' + rid + '/decode-' + decoder + '/decode-' + decoder + '.stdout.log']
            md5 = inputs.read('reference/framemd5/' + rid + '/' + decoder, md5path, md5fact['sha256'], md5fact['bytes'])
            pcm, info = recorded.decoded_pcm(wav, md5, case['rate'], case['channels'], case['frames'], case['modes'], source)
            need(info == original['decoded'][decoder] == bound['actual_reference_decoders'][decoder] and
                 len(pcm) == len(item['pcm']) == case['total_pcm'], 'Complete78 recorded WAV/framemd5 real-channel reference streams required')
            pcms[decoder], details[decoder] = pcm, info
            references[decoder] = dict(comparison=metrics.compare(pcm, item['pcm'], case['pcm']),
                alignment_diagnostic=metrics.alignment(pcm, item['pcm'], 8),
                reference_transition_nonzero=transition_counts(pcm, case, item['packet_offsets']),
                target_transition_nonzero=target_counts)
        cross = metrics.compare(pcms['vorbis'], pcms['libvorbis'], case['pcm'])
        need(whole(cross, case['channels'])['max_abs_error'] == accepted['cross_reference_max_abs_error'] ==
             original['cross_reference_max_abs_error'] == bound['cross_reference_max_abs_error'] and
             whole(cross, case['channels'])['max_abs_error'] <= 2 and
             accepted['pcm_sha256'] == details['libvorbis']['pcm_sha256'] == bound['reference_pcm_sha256'],
             'Actual full reference crosscheck/recorded qualification changed')
        rows.append(dict(case=index, id=case['id'], rate=case['rate'], channels=case['channels'], bits=16,
            frames=case['frames'], packet_bytes=case['pcm'], pcm_bytes=len(item['pcm']), floor_masks=case['floor_masks'],
            packet_offsets=item['packet_offsets'], reference_id=rid, references=references,
            original_reference_cross_comparison=cross, original_reference_metadata=details))
        result['cases'] = rows
        save()
    policy, bounded = bounded_policy(rows, args.max_abs_error)
    inputs.current()
    result.update(result='BOUNDED_CORPUS_PCM_QUALIFIED' if bounded else 'BOUNDED_CORPUS_PCM_REJECTED',
        measurement_completed=True, actual_reference_compared=True, target_platform_verified=True,
        complete_target_cases=39, complete_target_packets=546, complete_target_PCM_bytes=971520,
        complete_reference_streams_verified=78, complete_target_reference_comparisons=78,
        policy=policy, bounded_corpus_pcm_qualified=bounded,
        bounded_by_reference=policy['bounded_by_reference'], original_dual_reference_passed=True,
        original_dual_reference_scope='only-floor-presence39-campaign',
        original_reference_report_sha256=refs['host']['sha256'], original_reference_failures=host['failures'],
        previous_unrelated_NONPASS_reinterpreted=False, no_predeclared_metamorphic_groups=True,
        target_report_sha256=args.target_report_sha256, target_terminal_sha256=args.target_terminal_sha256,
        actual_runtime_preparation_sha256=args.runtime_preparation_sha256)
    save()
    return 0 if bounded else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('repository', 'runtime', 'target', 'target-terminal', 'output'):
        parser.add_argument('--' + name, type=Path, required=True)
    for name in ('target-report-sha256', 'target-terminal-sha256', 'runtime-preparation-sha256'):
        parser.add_argument('--' + name, required=True)
    parser.add_argument('--max-abs-error', type=int, choices=(2,), default=MAX_ABS_ERROR)
    args = parser.parse_args()
    need(all(re.fullmatch('[0-9a-f]{64}', getattr(args, name)) for name in
         ('target_report_sha256', 'target_terminal_sha256', 'runtime_preparation_sha256')), 'Reviewed actual lowercase SHA256 operands required')
    repo, output = args.repository.resolve(), args.output.resolve()
    protected = (HERE, args.target.resolve(), args.runtime.resolve(), args.target_terminal.resolve())
    need(output.parent == repo / '.build' and not output.exists() and all(
        not output.is_relative_to(path) and not path.is_relative_to(output) for path in protected), 'Fresh separate numeric output required')
    output.mkdir()
    result = dict(result='INCOMPLETE', measurement_completed=False, actual_reference_compared=False,
        bounded_corpus_pcm_qualified=False, passed=False, numeric_reference_qualified=False, format_corpus_qualified=False,
        format_conformance_qualified=False, checked_only=True, vendor_comparison_available=False,
        full_G6_qualified=False, physical_device=False, production_radio_integration=False,
        policy_predeclared_max_abs_error=2, policy_requires_both_existing_references=True, cases=[])

    def save():
        temp = output / 'report.json.tmp'
        temp.write_text(json.dumps(result, indent=2, allow_nan=False) + '\n', encoding='utf-8')
        temp.replace(output / 'report.json')

    save()
    try:
        code = run(args, result, save)
    except BaseException as error:
        result.update(result='INTERRUPTED' if isinstance(error, KeyboardInterrupt) else 'INPUT_OR_MEASUREMENT_REJECTED',
            measurement_completed=False, actual_reference_compared=False, bounded_corpus_pcm_qualified=False,
            error_type=type(error).__name__, error=str(error))
        save()
        return 130 if isinstance(error, KeyboardInterrupt) else 1
    print(json.dumps({name: result[name] for name in ('result', 'measurement_completed',
        'complete_target_reference_comparisons', 'bounded_corpus_pcm_qualified', 'bounded_by_reference')}))
    return code


if __name__ == '__main__':
    sys.exit(main())
