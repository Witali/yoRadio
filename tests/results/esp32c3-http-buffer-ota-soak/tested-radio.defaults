# Exact runtime settings of the tested ESP-IDF 6.1 radio candidate.
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM is not set
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
CONFIG_LWIP_TCP_WND_DEFAULT=8640
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
CONFIG_YORADIO_ADAPTIVE_INPUT_BUFFER=y
CONFIG_YORADIO_FLAC_INPUT_EXTRA_SLOTS=4
CONFIG_YORADIO_HTTP_RELEASE_REQUEST_BUFFER=y
CONFIG_YORADIO_INPUT_MIN_BLOCKS=5
CONFIG_YORADIO_INPUT_PREFILL_MIN_MS=1000
CONFIG_YORADIO_INPUT_PREFILL_MS=1000
CONFIG_YORADIO_PDM_FRACTIONAL_CLOCK=y
CONFIG_YORADIO_TCP_PCB_POOL=y
CONFIG_YORADIO_TLS_EARLY_MPI_LOCK=y
CONFIG_YORADIO_TLS_LARGE_BLOCK_RESERVE=y
CONFIG_YORADIO_TLS_RX_ONLY_RESERVE=y
