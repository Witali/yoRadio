[CmdletBinding()]
param([Parameter(Mandatory)][string]$CampaignDirectory,
      [Parameter(Mandatory)][string]$RepositoryDirectory,
      [Parameter(Mandatory)][string]$SdkDirectory,
      [Parameter(Mandatory)][string]$ToolsDirectory,
      [switch]$DisableReclaim)
# UNEXECUTED PREPARATION. Root review is required before a tool invocation.
$ErrorActionPreference = 'Stop'
$campaign = [IO.Path]::GetFullPath($CampaignDirectory)
$repository = [IO.Path]::GetFullPath($RepositoryDirectory)
$draft = Join-Path $repository '.build'
if (!$campaign.StartsWith($draft + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
    throw 'Target build output must stay in the repository ignored .build directory'
}
$sources = Join-Path $campaign 'sources'
$manifest = Join-Path $campaign 'source-manifest.json'
if (!(Test-Path -LiteralPath $manifest -PathType Leaf)) { throw 'Frozen manifest required' }
if ((Test-Path -LiteralPath (Join-Path $campaign 'working-build')) -or
    (Test-Path -LiteralPath (Join-Path $campaign 'working-sdkconfig'))) {
    throw 'Use a fresh frozen campaign; do not restart or overwrite previous build state'
}
$contract = Get-Content -LiteralPath $manifest -Raw | ConvertFrom-Json
foreach ($entry in $contract.frozen_sources.PSObject.Properties) {
    $file = [IO.Path]::GetFullPath((Join-Path $campaign $entry.Name))
    if (!$file.StartsWith($sources + [IO.Path]::DirectorySeparatorChar, [StringComparison]::OrdinalIgnoreCase)) {
        throw 'Frozen source path escapes the isolated campaign'
    }
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $file).Hash.ToLowerInvariant() -cne $entry.Value) {
        throw "Frozen source mismatch: $($entry.Name)"
    }
}
$env:IDF_PATH = [IO.Path]::GetFullPath($SdkDirectory)
$env:IDF_TOOLS_PATH = [IO.Path]::GetFullPath($ToolsDirectory)
$env:IDF_COMPONENT_MANAGER = '0'
$env:PYTHONDONTWRITEBYTECODE = '1'
$env:PYTHONNOUSERSITE = '1'
$env:PYTHONUTF8 = '1'
$env:PYTHONIOENCODING = 'utf-8'
$env:GIT_OPTIONAL_LOCKS = '0'
$env:GIT_CONFIG_COUNT = '1'
$env:GIT_CONFIG_KEY_0 = 'core.longpaths'
$env:GIT_CONFIG_VALUE_0 = 'true'
$env:CCACHE_DISABLE = '1'
$env:CMAKE_BUILD_PARALLEL_LEVEL = '2'
$env:RX_RESERVE_CANDIDATE = (Join-Path $sources 'candidate').Replace('\', '/')
$env:RX_RESERVE_RECLAIM = (Join-Path $sources 'reclaim').Replace('\', '/')
$env:RX_RESERVE_ADAPTIVE = (Join-Path $sources 'adaptive').Replace('\', '/')
$env:RX_RESERVE_PRODUCTION_KCONFIG = (Join-Path $sources 'reclaim/Kconfig.projbuild').Replace('\', '/')
$python = Join-Path $env:IDF_TOOLS_PATH 'python_env/idf6.0_py3.12_env/Scripts/python.exe'
$env:IDF_PYTHON_ENV_PATH = [IO.Path]::GetDirectoryName([IO.Path]::GetDirectoryName($python))
$env:Path = [IO.Path]::GetDirectoryName($python) + ';' + $env:Path
$temporary = Join-Path $campaign 'tool-temp'
[void][IO.Directory]::CreateDirectory($temporary)
$env:TEMP = $temporary
$env:TMP = $temporary
. (Join-Path $env:IDF_PATH 'export.ps1')
if ($LASTEXITCODE -ne 0) { throw 'Read-only SDK export failed' }
$exportedPath = @(Get-ChildItem Env: | Where-Object { $_.Name -imatch '^path$' -and $_.Value.Contains('tools\ninja') } | Select-Object -First 1 -ExpandProperty Value)
if ($exportedPath.Count -ne 1) { throw 'Pinned toolchain PATH missing' }
function Run-Hidden([string]$FileName, [string[]]$Arguments) {
    $start = [Diagnostics.ProcessStartInfo]::new()
    $start.FileName = $FileName
    $start.UseShellExecute = $false
    $start.CreateNoWindow = $true
    $start.RedirectStandardOutput = $true
    $start.RedirectStandardError = $true
    $start.Environment['PATH'] = $exportedPath[0]
    foreach ($argument in $Arguments) { [void]$start.ArgumentList.Add($argument) }
    $process = [Diagnostics.Process]::Start($start)
    $stdout = $process.StandardOutput.ReadToEndAsync()
    $stderr = $process.StandardError.ReadToEndAsync()
    $process.WaitForExit()
    Write-Output $stdout.GetAwaiter().GetResult()
    Write-Output $stderr.GetAwaiter().GetResult()
    if ($process.ExitCode -ne 0) { throw "Isolated SDK tool failed: $($process.ExitCode)" }
}
$head = & git -c core.longpaths=true -C $env:IDF_PATH rev-parse HEAD
if ($head.Trim() -cne $contract.SDK_commit) { throw 'Unsupported SDK commit' }
$dirty = & git -c core.longpaths=true -C $env:IDF_PATH status --porcelain --untracked-files=no
if ($dirty) { throw 'SDK tracked source must be clean' }
$project = Join-Path $sources 'project'
$build = Join-Path $campaign 'working-build'
$defaults = (Join-Path $project 'sdkconfig.defaults').Replace('\', '/')
if ($DisableReclaim) {
    $controlDefaults = Join-Path $campaign 'reclaim-disabled.defaults'
    [IO.File]::WriteAllText($controlDefaults, "CONFIG_YORADIO_TLS_INPUT_RECLAIM=n`n")
    $defaults += ';' + $controlDefaults.Replace('\', '/')
}
Run-Hidden $python @((Join-Path $env:IDF_PATH 'tools/idf.py'), '-C', $project, '-B', $build, '--no-ccache',
    '-D', 'IDF_TARGET=esp32', '-D', 'PROJECT_VER=tls-rx-fixture', '-D', "SDKCONFIG=$campaign/working-sdkconfig",
    '-D', "SDKCONFIG_DEFAULTS=$defaults", 'reconfigure')
$cache = Get-Content -LiteralPath (Join-Path $build 'CMakeCache.txt') -Raw
$ninja = [regex]::Match($cache, '(?m)^CMAKE_MAKE_PROGRAM:FILEPATH=(.+)$').Groups[1].Value.Trim()
if (!(Test-Path -LiteralPath $ninja -PathType Leaf)) { throw 'Actual configured Ninja missing' }
Run-Hidden $ninja @('-C', $build, '-j', '2')
foreach ($entry in $contract.frozen_sources.PSObject.Properties) {
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $campaign $entry.Name)).Hash.ToLowerInvariant() -cne $entry.Value) {
        throw "Frozen input drifted during build: $($entry.Name)"
    }
}
$dirty = & git -c core.longpaths=true -C $env:IDF_PATH status --porcelain --untracked-files=no
if ($dirty) { throw 'SDK source drifted during isolated build' }
