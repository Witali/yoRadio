function Hash-File([string]$path) {
    return (Get-FileHash -Algorithm SHA256 -LiteralPath $path).Hash.ToLowerInvariant()
}

function Normalize-Source([string]$path) {
    $normalized = $path.Replace('\', '/')
    if ($normalized -match 'native-httpd-rfc6455/(httpd_[^/]+\.c)$') {
        return 'native-httpd-rfc6455/' + $Matches[1]
    }
    if ($normalized -match '(idf/(?:components|esp32-cyd2usb-native)/.+)$') { return $Matches[1] }
    if ($normalized -match '(yoRadio/src/.+)$') { return $Matches[1] }
    return $normalized
}

function Read-Warnings($report) {
    $counts, $details = @{}, @{}
    foreach ($unit in $report.results) {
        foreach ($diagnostic in $unit.diagnostics) {
            $tuple = @((Normalize-Source $unit.file), (Normalize-Source $diagnostic.file),
                $diagnostic.severity, $diagnostic.check, $diagnostic.message)
            $key = ConvertTo-Json -InputObject $tuple -Compress
            if ($counts.ContainsKey($key)) { $counts[$key]++ } else {
                $counts[$key] = 1
                $details[$key] = [ordered]@{ unit=$tuple[0]; file=$tuple[1]; severity=$tuple[2];
                    check=$tuple[3]; message=$tuple[4]; locations=@() }
            }
            $details[$key].locations += [ordered]@{ line=$diagnostic.line; column=$diagnostic.column }
        }
    }
    return @{ counts=$counts; details=$details }
}

function Compare-Warnings($reference, $current) {
    $added, $removed = @(), @()
    $keys = @(@($reference.counts.Keys) + @($current.counts.Keys) | Sort-Object -Unique)
    foreach ($key in $keys) {
        $before = if ($reference.counts.ContainsKey($key)) { $reference.counts[$key] } else { 0 }
        $after = if ($current.counts.ContainsKey($key)) { $current.counts[$key] } else { 0 }
        if ($after -gt $before) {
            $added += [ordered]@{ tuple=(ConvertFrom-Json $key); count=$after-$before }
        }
        if ($before -gt $after) {
            $removed += [ordered]@{ tuple=(ConvertFrom-Json $key); count=$before-$after }
        }
    }
    return [ordered]@{ identical=($added.Count -eq 0 -and $removed.Count -eq 0);
        added=$added; removed=$removed }
}

