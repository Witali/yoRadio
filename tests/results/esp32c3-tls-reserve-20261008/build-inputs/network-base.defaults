# Matched network-memory control; compact AAC comes from board defaults.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_FLASH_AUTO_SUSPEND is not set
CONFIG_YORADIO_NETWORK_HEAP_PROFILE=y
# CONFIG_YORADIO_RX_BUFFER_DIAGNOSTICS is not set
# CONFIG_YORADIO_DIRECT_DMA_PCM is not set
# CONFIG_YORADIO_PIPELINE_PROFILE is not set
