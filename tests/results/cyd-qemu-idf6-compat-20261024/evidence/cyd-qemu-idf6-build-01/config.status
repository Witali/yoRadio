#!/bin/sh
# Generated by configure.
# Run this file to recreate the current configuration.
# Compiler output produced by configure, useful for debugging
# configure, is in config.log if it exists.
unset AR
unset AS
unset CC
unset CFLAGS
unset CXX
unset CXXFLAGS
unset DLLTOOL
unset LD
unset LDFLAGS
unset LD_LIBRARY_PATH
unset NM
unset OBJCFLAGS
unset OBJCOPY
PATH='/mingw64/bin:/usr/bin'
export PATH
unset PKG_CONFIG
unset PKG_CONFIG_LIBDIR
unset PKG_CONFIG_PATH
unset PYTHON
unset QEMU_GA_MANUFACTURER
unset QEMU_GA_DISTRO
unset QEMU_GA_VERSION
unset SDL2_CONFIG
unset SMBD
unset STRIP
unset WIDL
unset WINDRES
unset WINDMC
exec '../configure' '--disable-download' '--enable-fdt=internal' '--bindir=bin' '--datadir=share/qemu' '--enable-gcrypt' '--enable-pixman' '--enable-sdl' '--enable-slirp' '--enable-stack-protector' '--disable-werror' '--prefix=/c/Work/QEMU-ESP32/.worktree/cyd-idf6-compat/install/qemu' '--static' '--target-list=xtensa-softmmu' '--with-pkgversion=CYD-IDF6-compat' '--with-suffix=' '--without-default-features' "$@"
