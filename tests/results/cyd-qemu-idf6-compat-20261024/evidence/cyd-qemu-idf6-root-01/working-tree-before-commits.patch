+    /*
+     * SSI transfers complete wire bytes. ESP-IDF on classic ESP32 puts four
+     * continuous-read mode bits in the address phase (QIO: 28 address bits,
+     * five dummy clocks). The last address byte already contains four dummy
+     * bits, so round the combined phases rather than rounding each twice.
+     */
+    return DIV_ROUND_UP(addr_bits + clocks * lanes, 8) -
+           DIV_ROUND_UP(addr_bits, 8);
+}
