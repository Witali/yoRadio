+    image[0x3700fc:0x3700fe], image[0x3710fc:0x3710fe] = b"\xb9\x04", b"\xa6\x04"
+    flash = folder / "synthetic-flash.bin"
+    flash.write_bytes(image)
+    inputs = [qemu, Path(__file__).resolve(), CONTROLLER, flash,
