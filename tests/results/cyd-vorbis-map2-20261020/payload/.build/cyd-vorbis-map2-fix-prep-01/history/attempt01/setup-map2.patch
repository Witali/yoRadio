-          ((ogg_uint16_t *)(s->q_val))[i]=tremor_oggpack_read(opb,s->q_bits);
+      {
+        size_t used=0;
+        for(i=0;i<s->entries;i++){
+          for(j=0;j<s->dim;j++){
+            long value=tremor_oggpack_read(opb,s->q_bits);
+            if(lengthlist[i]){
+              size_t offset=used*(size_t)s->dim+(size_t)j;
+              if(s->q_bits<=8)
+                ((unsigned char *)s->q_val)[offset]=value;
