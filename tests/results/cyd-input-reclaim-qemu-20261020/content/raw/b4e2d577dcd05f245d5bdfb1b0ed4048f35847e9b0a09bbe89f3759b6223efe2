#include "native_input_reclaim.h"

#include <stdint.h>

static portMUX_TYPE s_reclaim_lock = portMUX_INITIALIZER_UNLOCKED;
static adaptive_input_t *s_owner;
static size_t s_pins;
static bool s_retiring;

bool native_input_reclaim_bind(adaptive_input_t *input) {
    if (!input || xPortInIsrContext()) return false;
    portENTER_CRITICAL(&s_reclaim_lock);
    bool accepted = !s_retiring && (!s_owner || s_owner == input);
    if (accepted) s_owner = input;
    portEXIT_CRITICAL(&s_reclaim_lock);
    return accepted;
}

native_input_reclaim_detach_result_t native_input_reclaim_detach(adaptive_input_t *input) {
    if (!input || xPortInIsrContext()) return NATIVE_INPUT_RECLAIM_WRONG_OWNER;
    portENTER_CRITICAL(&s_reclaim_lock);
    native_input_reclaim_detach_result_t result;
    if (s_owner != input) result = NATIVE_INPUT_RECLAIM_WRONG_OWNER;
    else if (s_pins) {
        s_retiring = true;
        result = NATIVE_INPUT_RECLAIM_BUSY;
    } else {
        s_owner = NULL;
        s_retiring = false;
        result = NATIVE_INPUT_RECLAIM_DETACHED;
    }
    portEXIT_CRITICAL(&s_reclaim_lock);
    return result;
}

static adaptive_input_t *pin_input(void) {
    portENTER_CRITICAL(&s_reclaim_lock);
    adaptive_input_t *input = NULL;
    if (s_owner && !s_retiring && s_pins != SIZE_MAX) {
        ++s_pins;
        input = s_owner;
    }
    portEXIT_CRITICAL(&s_reclaim_lock);
    return input;
}

static void unpin_input(void) {
    portENTER_CRITICAL(&s_reclaim_lock);
    --s_pins;
    portEXIT_CRITICAL(&s_reclaim_lock);
}

void *__real_esp_mbedtls_mem_calloc(size_t count, size_t size);

void *__wrap_esp_mbedtls_mem_calloc(size_t count, size_t size) {
    void *result = NULL;
    if (result || !count || !size || size > SIZE_MAX / count || xPortInIsrContext())
        return result;
    adaptive_input_t *input = pin_input();
    if (!input) return NULL;
    adaptive_input_stats_t stats = adaptive_input_stats(input);
    const unsigned budget = stats.target - stats.minimum;
    for (unsigned attempt = 0; !result && attempt < budget; ++attempt) {
        if (!adaptive_input_release_one(input)) break;
        result = __real_esp_mbedtls_mem_calloc(count, size);
    }
    unpin_input();
    return result;
}
