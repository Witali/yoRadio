c.write(out / 'scripts-before.json', {name: c.sha(c.HERE / name) for name in (*c.SCRIPTS, 'prepare-capture.py')})
with (out / 'stdout.log').open('wb') as stdout, (out / 'stderr.log').open('wb') as stderr:
    done = subprocess.run(command, cwd=c.DEFAULT_ROOT, env=c.environment(), stdout=stdout, stderr=stderr)
terminal = {'exit_status': done.returncode, 'stdout_sha256': c.sha(out / 'stdout.log'),
            'stderr_sha256': c.sha(out / 'stderr.log'), 'sdk_build_executed': False,
            'scripts_after': {name: c.sha(c.HERE / name) for name in (*c.SCRIPTS, 'prepare-capture.py')}}
