import json
from pathlib import Path
import subprocess
import sys
import contract as c

out = c.HERE / 'prepare-attempt-01'
c.require(not out.exists(), 'Keep existing terminal evidence')
out.mkdir()
command = [sys.executable, '-B', '-X', 'utf8', str(c.HERE / 'prepare.py'),
           '--expected-head', '1190aebce400375c382a5ad54211e2400f98161d',
           '--powershell', 'C:/Users/rudol/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/powershell/pwsh.exe']
