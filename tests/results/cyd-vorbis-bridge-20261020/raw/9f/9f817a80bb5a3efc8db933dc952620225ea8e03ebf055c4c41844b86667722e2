"""Configure-only exact Vorbis guard controls; no compiler, SDK or decoder run."""
from pathlib import Path
import argparse
import hashlib
import json
import os
import shutil
import subprocess

HERE=Path(__file__).resolve().parent
ROOT=HERE.parents[1]
COMPONENT=Path('C:/Work/yoRadio/.idf/esp-adf-libs/esp_audio_codec')
CMAKE=Path('C:/Work/yoRadio/.idf/tools-v6.0.2/tools/cmake/4.0.3/bin/cmake.exe')
NINJA=Path('C:/Work/yoRadio/.idf/tools-v6.0.2/tools/ninja/1.12.1/ninja.exe')
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output',type=Path,default=HERE/'guard-02')
OUT=parser.parse_args().output.resolve()
assert OUT!=HERE and OUT.is_relative_to(HERE)
OUT.mkdir(exist_ok=False)
sha=lambda raw:hashlib.sha256(raw).hexdigest()
inputs={}
def frozen(path,label):
 raw=path.read_bytes();target=OUT/'inputs'/label;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(raw)
 inputs[str(path.resolve())]={'sha256':sha(raw),'snapshot':target.relative_to(OUT).as_posix()};return raw
helper=HERE/'candidate/main/compat/vorbis_repair/enable.cmake'
helper_raw=frozen(helper,'enable.cmake')
frozen(Path(__file__).resolve(),'check_guard.py')
good=OUT/'components/good'
for name in ('codec','simple_dec'):
 raw=frozen(COMPONENT/f'lib/esp32/libesp_audio_{name}.a',f'libesp_audio_{name}.a')
 target=good/f'lib/esp32/libesp_audio_{name}.a';target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(raw)
for kind in ('bad-codec','bad-simple','missing-codec','missing-simple'):
 target=OUT/'components'/kind;shutil.copytree(good,target)
 name='codec' if kind.endswith('codec') else 'simple_dec'
 path=target/f'lib/esp32/libesp_audio_{name}.a'
 if kind.startswith('missing'):path.unlink()
 else:path.write_bytes(path.read_bytes()+b'guard-mutation')
wraps=('esp_vorbis_dec_open','esp_vorbis_dec_register','esp_vorbis_dec_decode','esp_audio_simple_dec_open',
 'esp_audio_simple_dec_process','esp_audio_simple_dec_reset','esp_es_parse_frame','esp_ogg_parse_frame','media_lib_module_realloc')
cases={
 'enabled':{},'disabled':{'enabled':False},'early':{'early':True},
 'wrong-target':{'target':'esp32c3','error':'requires classic ESP32 Xtensa'},
 'missing-target-bool':{'target_bool':False,'error':'requires classic ESP32 Xtensa'},
 'wrong-major':{'major':'5','error':'requires pinned ESP-IDF 6.0.2'},
 'wrong-minor':{'minor':'1','error':'requires pinned ESP-IDF 6.0.2'},
 'wrong-patch':{'patch':'1','error':'requires pinned ESP-IDF 6.0.2'},
 'missing-version':{'major':None,'error':'requires pinned ESP-IDF 6.0.2'},
 'malformed-minor':{'minor':'unknown','error':'requires pinned ESP-IDF 6.0.2'},
 'malformed-patch':{'patch':'2suffix','error':'requires pinned ESP-IDF 6.0.2'},
 'absent-component':{'target_name':'absent','error':'requires registered component target'},
 'missing-component-env':{'component':'','error':'requires pinned codec component directory'},
 'bad-codec':{'component':'bad-codec','error':'requires audited ESP32 codec archive'},
 'bad-simple':{'component':'bad-simple','error':'requires audited ESP32 simple_dec archive'},
 'missing-codec':{'component':'missing-codec','error':'missing codec archive'},
 'missing-simple':{'component':'missing-simple','error':'missing simple_dec archive'},
 **{f'missing-{name}':{'missing':name,'error':f'missing canonical {name}'} for name in ('setup.c','simple.c','output.c')},
 'missing-abi':{'missing':'vorbis_repair_abi.h','error':'missing canonical ABI header'},
}
report={'passed':False,'configure_only':True,'no_firmware_compilation':True,'cases':{},'inputs':inputs,
 'tools':{str(p):sha(p.read_bytes()) for p in (CMAKE,NINJA)}}
def save(): (OUT/'report.json').write_text(json.dumps(report,indent=2)+'\n')
save()
for name, overrides in cases.items():
 values={'enabled':True,'early':False,'target':'esp32','target_bool':True,'major':'6','minor':'0','patch':'2','target_name':'vorbis_target','component':'good'}
 values.update(overrides)
 if name in ('disabled','early'):
  values.update(target='invalid',major=None,target_name='absent',component='')
 directory=OUT/name;project=directory/'project';project.mkdir(parents=True)
 main=project/'main';(main/'compat/vorbis_repair').mkdir(parents=True)
 (main/'compat/vorbis_repair/enable.cmake').write_bytes(helper_raw)
 for source in ('vorbis_repair/setup.c','vorbis_repair/simple.c','vorbis_repair/output.c','vorbis_repair_abi.h'):
  target=main/source;target.parent.mkdir(parents=True,exist_ok=True)
  if Path(source).name!=values.get('missing'):target.write_text('/* Configure-only path fixture; never compiled. */\n')
 settings={'CONFIG_YORADIO_VORBIS_REPAIR':'ON' if values['enabled'] else 'OFF','CMAKE_BUILD_EARLY_EXPANSION':'ON' if values['early'] else 'OFF',
  'IDF_TARGET':values['target'],'CONFIG_IDF_TARGET_ESP32':'ON' if values['target_bool'] else 'OFF',
  'IDF_VERSION_MAJOR':values['major'],'IDF_VERSION_MINOR':values['minor'],'IDF_VERSION_PATCH':values['patch'],'COMPONENT_LIB':values['target_name']}
 lines=['cmake_minimum_required(VERSION 3.20)','project(VorbisGuard NONE)','add_library(vorbis_target INTERFACE)',
  'target_link_options(vorbis_target INTERFACE "-Wl,--undefined=preserve_existing")']
 lines.extend(f'set({k} "{v}")' for k,v in settings.items() if v is not None)
 lines+=['include("'+(main/'compat/vorbis_repair/enable.cmake').as_posix()+'")','native_enable_vorbis_repair()',
  'get_target_property(sources vorbis_target SOURCES)','get_target_property(options vorbis_target INTERFACE_LINK_OPTIONS)',
  'file(WRITE "${CMAKE_BINARY_DIR}/captured.txt" "${sources}\\n${options}\\n")']
 (project/'CMakeLists.txt').write_text('\n'.join(lines)+'\n')
 env=os.environ.copy();env['YORADIO_AUDIO_CODEC_COMPONENT']=str(OUT/'components'/values['component']) if values['component'] else ''
 command=[str(CMAKE),'-G','Ninja','-DCMAKE_MAKE_PROGRAM='+NINJA.as_posix(),'-S',project.as_posix(),'-B',(directory/'build').as_posix()]
 (directory/'command.json').write_text(json.dumps(command,indent=2)+'\n')
 result=subprocess.run(command,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=30)
 (directory/'configure.log').write_bytes(result.stdout)
 expected=overrides.get('error')
 if expected:assert result.returncode!=0 and expected.encode() in result.stdout,(name,result.stdout)
 else:
  assert result.returncode==0,(name,result.stdout)
  sources,options=(directory/'build/captured.txt').read_text().splitlines()
  expected_options=['-Wl,--undefined=preserve_existing']
  if name=='enabled':
   assert sources.split(';')==[(main/f'vorbis_repair/{s}.c').as_posix() for s in ('setup','simple','output')]
   expected_options += ['-Wl,--wrap='+s for s in wraps]
  else:assert sources=='sources-NOTFOUND'
  assert options.split(';')==expected_options,(name,options)
 report['cases'][name]={'passed':True,'expected_rejection':bool(expected),'predicate':expected,'exit_status':result.returncode,'log_sha256':sha(result.stdout)}
 save();print('PASS '+name,flush=True)
report['all_inputs_unchanged_after']=all(sha(Path(path).read_bytes())==row['sha256'] for path,row in inputs.items())
report['all_tools_unchanged_after']=all(sha(Path(path).read_bytes())==digest for path,digest in report['tools'].items())
assert report['all_inputs_unchanged_after'] and report['all_tools_unchanged_after']
report['passed']=True;save()
print(json.dumps({'passed':True,'cases':len(cases),'report':str(OUT/'report.json')}))
