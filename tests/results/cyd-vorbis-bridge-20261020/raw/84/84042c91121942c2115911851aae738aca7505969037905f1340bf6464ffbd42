def members(raw):
 assert raw[:8]==b'!<arch>\n';pos=8;table=b'';index=0
 while pos<len(raw):
  header=raw[pos:pos+60];assert header[58:]==b'`\n';size=int(header[48:58]);name=header[:16].decode().strip()
  data=raw[pos+60:pos+60+size];pos+=60+size+size%2;index+=1
  if name=='//': table=data;continue
  if name=='/':continue
  name=table[int(name[1:]):].split(b'/\n',1)[0].decode() if name.startswith('/') and name[1:].isdigit() else name.rstrip('/')
  yield index,name,data
def elf(raw):
 assert raw[:6]==b'\x7fELF\x01\x01';machine=struct.unpack_from('<H',raw,18)[0]
 off=struct.unpack_from('<I',raw,32)[0];size,count,names=struct.unpack_from('<HHH',raw,46)
 sections=[struct.unpack_from('<10I',raw,off+i*size) for i in range(count)]
 n=sections[names];strings=raw[n[4]:n[4]+n[5]]
 named={strings[s[0]:].split(b'\0',1)[0].decode():s for s in sections}
 symbols={}
 for s in sections:
  if s[1]!=2:continue
  n=sections[s[6]];strings=raw[n[4]:n[4]+n[5]]
  for p in range(s[4],s[4]+s[5],s[9]):
   name,value,bytes_,info,other,index=struct.unpack_from('<IIIBBH',raw,p)
   if name:
    text=strings[name:].split(b'\0',1)[0].decode()
    symbols[text]={'bytes':bytes_,'section_relative_offset':value,'defined':bool(index),'binding':info>>4,'type':info&15}
 return machine,named,symbols

