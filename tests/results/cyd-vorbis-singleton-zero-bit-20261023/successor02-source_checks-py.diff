+def validate_plan_paths(root, plan):
+    """Read JSON metadata and filesystem entries only, before any payload packing."""
+    selected = []
+    for role, row in plan['roles'].items():
+        selected += [('role-root/' + role, row['path'], True),
+                     ('role-report/' + role, row['path'] + '/report.json', False),
+                     ('role-terminal/' + role, row['terminal'], False)]
+    selected += [('tree', name, True) for name in plan['trees']]
+    selected += [('extra', name, False) for name in plan['extras']]
+    for name in plan['extra_receipts']:
+        selected.append(('receipt', name, False))
+        receipt = root / name
+        if not receipt.is_file():
+            raise FileNotFoundError('receipt: ' + name)
+        for log in json.loads(receipt.read_bytes()).get('logs', {}):
+            selected.append(('receipt-log', log, False))
+    selected.append(('checkpoint', plan['checkpoint']['path'], False))
+    for kind, name, directory in selected:
+        path = (root / name).resolve()
+        assert path.is_relative_to(root), ('Selected path outside task worktree', kind, name)
+        if not (path.is_dir() if directory else path.is_file()):
+            raise FileNotFoundError(kind + ': ' + name)
+    return [{'kind': kind, 'path': name, 'directory': directory} for kind, name, directory in selected]
+
+
+def original_metadata_members(tree):
+    """Audit actual AST consumers; do not import or execute the verifier."""
+    body = function(tree, 'verify')
+    indexed = [node for node in ast.walk(body) if isinstance(node, ast.Subscript)
+               and isinstance(node.value, ast.Name) and node.value.id == 'old_index']
+    assert len(indexed) == 1 and ast.literal_eval(indexed[0].slice) == 'files'
+    loops = [node for node in ast.walk(body) if isinstance(node, ast.For)
+             and any(child is indexed[0] for child in ast.walk(node))]
+    assert len(loops) == 1 and isinstance(loops[0].target, ast.Name) and loops[0].target.id == 'name'
+    names = ast.literal_eval(loops[0].iter)
+    assert isinstance(names, tuple) and all(isinstance(name, str) for name in names)
+    direct, dynamic = set(), []
+    for node in ast.walk(body):
+        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add) and isinstance(node.left, ast.Name) and node.left.id == 'original_root':
+            if isinstance(node.right, ast.Constant):
+                direct.add(node.right.value)
+            else:
+                assert isinstance(node.right, ast.Name) and node.right.id == 'name'
+                dynamic.append(node)
+    assert direct == {'manifest.json', 'matrix.json', 'bitfields.json'} and len(dynamic) == 2
+    assert all(any(child is node for child in ast.walk(loops[0])) for node in dynamic)
+    return names, sorted(direct - {'manifest.json'})
+
+
+def require_manifest_members(names, manifest):
+    members = {row['path'] for row in manifest['files']}
+    missing = sorted(set(names) - members)
+    if missing:
+        raise ValueError('Original manifest missing: ' + ','.join(missing))
 
 
