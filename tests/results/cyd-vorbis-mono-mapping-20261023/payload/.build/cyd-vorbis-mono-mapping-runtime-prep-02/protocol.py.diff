+def channel_nonzero(pcm, channels):
+    """Complete little-endian PCM16 frames; mono has no synthetic second channel."""
+    need(type(channels) is int and channels in (1, 2) and len(pcm) % (2 * channels) == 0,
+         "complete mono/stereo PCM16 frames")
+    values = [sum(pcm[pos:pos + 2] != b"\0\0" for pos in range(channel * 2, len(pcm), channels * 2))
+              for channel in range(channels)]
+    return dict(nz_l=values[0], nz_r=values[1] if channels == 2 else 0)
 
 
