function(ota_dependency_export_properties)
  if(NOT TARGET __idf_native_ota)
    message(FATAL_ERROR "OTA target missing from component check")
  endif()
  get_target_property(ota_links __idf_native_ota LINK_LIBRARIES)
  get_target_property(ota_interface_links __idf_native_ota INTERFACE_LINK_LIBRARIES)
  get_target_property(ota_includes __idf_native_ota INCLUDE_DIRECTORIES)
  idf_build_get_property(ota_build_components BUILD_COMPONENTS)
  if(TARGET __idf_native_stream)
    get_target_property(ota_stream_type __idf_native_stream TYPE)
    get_target_property(ota_stream_sources __idf_native_stream SOURCES)
  else()
    set(ota_stream_type absent)
    set(ota_stream_sources absent)
  endif()
  file(WRITE "${CMAKE_BINARY_DIR}/ota-target-properties.txt"
    "LINK_LIBRARIES=${ota_links}\nINTERFACE_LINK_LIBRARIES=${ota_interface_links}\nINCLUDE_DIRECTORIES=${ota_includes}\nBUILD_COMPONENTS=${ota_build_components}\nNATIVE_STREAM_TYPE=${ota_stream_type}\nNATIVE_STREAM_SOURCES=${ota_stream_sources}\n")
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL ota_dependency_export_properties)
