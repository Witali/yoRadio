# Uncompacted full-rate AAC control; apply after sdkconfig.defaults in a fresh
# build directory. Keep SBR/PS enabled, but use the original native storage.
CONFIG_YORADIO_AAC_PLUS=y
# CONFIG_YORADIO_AAC_COMPACT_SBR is not set
# CONFIG_YORADIO_AAC_HIGH_HISTORY is not set
# CONFIG_YORADIO_AAC_HIGH_HISTORY_PC19 is not set
# CONFIG_YORADIO_AAC_SMOOTHING_HISTORY is not set
# CONFIG_YORADIO_AAC_LOW_WORKSPACE is not set
# CONFIG_YORADIO_AAC_ASYMMETRIC_OWNER is not set
# CONFIG_YORADIO_AAC_LATE_SBR is not set
