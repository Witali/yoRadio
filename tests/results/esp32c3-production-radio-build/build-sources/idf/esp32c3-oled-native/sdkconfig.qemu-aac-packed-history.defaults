# Apply after sdkconfig.defaults and sdkconfig.qemu.defaults. Emulator only.
CONFIG_YORADIO_QEMU_AAC_TEST=y
CONFIG_YORADIO_QEMU_AAC_PACKED_HISTORY_TEST=y
CONFIG_YORADIO_QEMU_AAC_PACKED_HISTORY_ERROR_LIMIT=5
# CONFIG_YORADIO_QEMU_AAC_BFP16_TEST is not set
# CONFIG_YORADIO_CODEC_MEMORY_TRACE is not set
# CONFIG_YORADIO_QEMU_AAC_PROFILE is not set
# CONFIG_YORADIO_QEMU_CACHE_TEST is not set
