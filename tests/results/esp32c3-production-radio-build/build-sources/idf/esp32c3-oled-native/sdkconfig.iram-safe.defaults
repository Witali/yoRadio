# Optional C3 IRAM experiment; apply after the AAC RAM / bounded-Wi-Fi profile.
# The OLED I2C ISR and ring-buffer users are not registered as cache-safe ISRs.
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR is not set
