        void *context = httpd_sess_get_ctx(server, socket);
        for (size_t i = 0; i < CONFIG_LWIP_MAX_SOCKETS; ++i) {
            ws_client_t *client = &s_clients[i];
            if (context == client && client->used && !client->closing &&
                client->socket == socket) return client;
        }
        return NULL;
