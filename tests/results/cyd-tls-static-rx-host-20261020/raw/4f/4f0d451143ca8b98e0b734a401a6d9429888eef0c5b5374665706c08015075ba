set(REPOSITORY "$ENV{RX_RESERVE_REPOSITORY}")
set(C "${REPOSITORY}/idf/esp32-cyd2usb-native/main")
set(A "${REPOSITORY}/idf/components/native_stream")
if(CONFIG_YORADIO_TLS_STATIC_RX_RESERVE)
    set(reserve_fixture_entry "main.c")
else()
    set(reserve_fixture_entry "disabled.c")
endif()
idf_component_register(SRCS "${reserve_fixture_entry}" "${A}/adaptive_input.c"
    INCLUDE_DIRS "." "${C}" "${A}/include"
    REQUIRES freertos heap esp_system esp_timer mbedtls esp-tls esp_http_server)
include("${C}/compat/tls_static_rx/enable.cmake")
native_enable_tls_static_rx_reserve()
include("${C}/compat/input_reclaim/enable.cmake")
native_enable_tls_input_reclaim()
if(CONFIG_YORADIO_TLS_STATIC_RX_RESERVE)
    foreach(symbol yoradio_tls_static_rx_calloc mbedtls_platform_zeroize heap_caps_calloc heap_caps_free esp_crt_bundle_attach)
        target_link_options(${COMPONENT_LIB} INTERFACE "-Wl,--wrap=${symbol}")
    endforeach()
endif()
target_compile_options(${COMPONENT_LIB} PRIVATE -Wall -Wextra -Werror)
