"""Allow a fresh clone's first .build output without precreating its parent."""
from pathlib import Path
import json
import hashlib
HERE=Path(__file__).resolve().parent
files=[*sorted((HERE/'repository/tests').glob('run-cyd-tls-static-rx-*.py')),HERE/'repository/tests/native/cyd_tls_static_rx/target/freeze-run.py']
changes=[]
for path in files:
    before=path.read_bytes();text=before.decode()
    assert text.count('out.mkdir()')==1,path
    path.write_bytes(text.replace('out.mkdir()','out.mkdir(parents=True)',1).encode())
    changes.append({'file':str(path.relative_to(HERE)),'before_sha256':hashlib.sha256(before).hexdigest(),'after_sha256':hashlib.sha256(path.read_bytes()).hexdigest()})
(HERE/'output-path-review.json').write_text(json.dumps({'scope':__doc__,'changes':changes,'compiler_or_target':False},indent=2)+'\n')
