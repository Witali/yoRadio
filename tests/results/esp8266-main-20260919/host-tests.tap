    #define KARADIO_RING_BYTES 4096U
    #define KARADIO_PREBUFFER_BYTES (KARADIO_RING_BYTES * 3U / 4U)
    #define KARADIO_NETWORK_STACK_BYTES 2560U
    #define KARADIO_NETWORK_PRIORITY 6U
    #define KARADIO_AUDIO_PRIORITY 5U
