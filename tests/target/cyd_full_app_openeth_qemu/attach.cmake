# Loaded only by the dedicated QEMU build through CMAKE_PROJECT_<name>_INCLUDE.
include("${CMAKE_CURRENT_LIST_DIR}/../../../idf/esp32-cyd2usb-native/main/compat/sdk_source_overlay.cmake")

function(cyd_attach_openeth_probe)
  if(NOT CONFIG_IDF_TARGET_ESP32 OR NOT CONFIG_ETH_USE_OPENETH OR CONFIG_FREERTOS_UNICORE)
    message(FATAL_ERROR "CYD OpenETH probe requires the dual-core ESP32 and OpenETH")
  endif()
  idf_component_get_property(app main COMPONENT_LIB)
  target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/network.c")
  target_link_libraries(${app} PRIVATE idf::esp_eth)
  target_link_options(${app} INTERFACE "-Wl,--wrap=network_service_start")
  if(CYD_OPENETH_ALLOCATION_PROBE)
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/allocation.c")
    target_link_options(${app} INTERFACE "-Wl,--wrap=malloc" "-Wl,--wrap=calloc")
  endif()
  if(CYD_OPENETH_PCM_PROBE)
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pcm.c")
    target_link_options(${app} INTERFACE "-Wl,--wrap=native_audio_output_write_pcm"
                        "-Wl,--wrap=native_audio_output_flush_pcm")
  endif()
  if(CYD_OPENETH_PCM_MD5)
    if(NOT CYD_OPENETH_PCM_PROBE)
      message(FATAL_ERROR "PCM MD5 requires CYD_OPENETH_PCM_PROBE")
    endif()
    target_compile_definitions(${app} PRIVATE CYD_OPENETH_PCM_MD5=1)
  endif()
  if(CYD_OPENETH_PCM_CHANNEL_METRICS)
    if(NOT CYD_OPENETH_PCM_PROBE)
      message(FATAL_ERROR "PCM channel metrics require CYD_OPENETH_PCM_PROBE")
    endif()
    target_compile_definitions(${app} PRIVATE CYD_OPENETH_PCM_CHANNEL_METRICS=1)
    target_link_options(${app} INTERFACE "-Wl,--wrap=native_audio_output_set_channel_layout")
  endif()
  if(CYD_OPENETH_PCM_SHA256)
    if(NOT CYD_OPENETH_PCM_PROBE)
      message(FATAL_ERROR "PCM SHA-256 requires CYD_OPENETH_PCM_PROBE")
    endif()
    target_compile_definitions(${app} PRIVATE CYD_OPENETH_PCM_SHA256=1)
  endif()
  if(CYD_OPENETH_OPUS_HEAP_PROBE)
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/opus_heap.c")
    target_link_options(${app} INTERFACE "-Wl,--wrap=esp_opus_dec_open")
  endif()
  if(CYD_OPENETH_TLS_RX_PROBE)
    if(NOT CONFIG_YORADIO_TLS_STATIC_RX_RESERVE)
      message(FATAL_ERROR "The TLS RX probe requires the static RX reserve")
    endif()
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tls_rx.c")
    # Mbed TLS can follow libmain in the link order. Pull in the probe first.
    target_link_options(${app} INTERFACE "-Wl,-u,__wrap_yoradio_tls_static_rx_calloc"
                        "-Wl,--wrap=yoradio_tls_static_rx_calloc"
                        "-Wl,--wrap=yoradio_tls_static_rx_free"
                        "-Wl,--wrap=yoradio_tls_static_rx_zeroize_free")
  endif()
  if(CYD_OPENETH_RECLAIM_PROBE)
    if(NOT CYD_OPENETH_TLS_RX_PROBE OR NOT CYD_OPENETH_PCM_MD5 OR
       NOT CONFIG_YORADIO_TLS_INPUT_RECLAIM)
      message(FATAL_ERROR "The reclaim probe requires static RX and PCM MD5 probes and TLS input reclaim")
    endif()
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/input_pressure.c")
    target_compile_definitions(${app} PRIVATE CYD_OPENETH_RECLAIM_PROBE=1)
    target_link_options(${app} INTERFACE "-Wl,--wrap=esp_http_client_read")
  endif()
  if(CYD_OPENETH_TLS_OVERLAP_PROBE)
    if(NOT CYD_OPENETH_RECLAIM_PROBE)
      message(FATAL_ERROR "The overlap probe requires the input reclaim probe")
    endif()
    target_compile_definitions(${app} PRIVATE CYD_OPENETH_TLS_OVERLAP_PROBE=1)
    target_link_options(${app} INTERFACE "-Wl,--wrap=esp_tls_server_session_init"
                        "-Wl,--wrap=esp_tls_server_session_continue_async")
  endif()
  if(CYD_OPENETH_RX_BACKOFF)
    cyd_overlay_sdk_source(esp_eth src/openeth/esp_eth_mac_openeth.c
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prepare-rx-source.py" openeth-rx-overlay)
  endif()
endfunction()

cmake_language(DEFER CALL cyd_attach_openeth_probe)
