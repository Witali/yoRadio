# Loaded only by the dedicated QEMU build through CMAKE_PROJECT_<name>_INCLUDE.
function(cyd_overlay_sdk_source component relative_source generator output_dir)
  idf_component_get_property(target ${component} COMPONENT_LIB)
  idf_component_get_property(directory ${component} COMPONENT_DIR)
  idf_build_get_property(idf_python PYTHON)
  set(original "${directory}/${relative_source}")
  get_filename_component(filename "${original}" NAME)
  get_filename_component(headers "${original}" DIRECTORY)
  set(generated "${CMAKE_BINARY_DIR}/${output_dir}/${filename}")
  set(patcher "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${generator}")
  get_target_property(original_sources ${target} SOURCES)
  set(replaced 0)
  set(sources)
  foreach(source IN LISTS original_sources)
    get_filename_component(path "${source}" REALPATH BASE_DIR "${directory}")
    if(path STREQUAL original)
      list(APPEND sources "${generated}")
      math(EXPR replaced "${replaced}+1")
    else()
      list(APPEND sources "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "Expected one ${filename} SDK source, found ${replaced}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${patcher}")
  execute_process(COMMAND "${idf_python}" -B "${patcher}" --input "${original}" --output "${generated}"
                  ${ARGN}
                  COMMAND_ERROR_IS_FATAL ANY)
  set_property(TARGET ${target} PROPERTY SOURCES ${sources})
  target_include_directories(${target} PRIVATE "${headers}")
endfunction()

function(cyd_attach_openeth_probe)
  if(NOT CONFIG_IDF_TARGET_ESP32 OR NOT CONFIG_ETH_USE_OPENETH OR CONFIG_FREERTOS_UNICORE)
    message(FATAL_ERROR "CYD OpenETH probe requires the dual-core ESP32 and OpenETH")
  endif()
  idf_component_get_property(app main COMPONENT_LIB)
  target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/network.c")
  target_link_libraries(${app} PRIVATE idf::esp_eth)
  target_link_options(${app} INTERFACE "-Wl,--wrap=network_service_start")
  if(CYD_OPENETH_PCM_PROBE)
    target_sources(${app} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pcm.c")
    target_link_options(${app} INTERFACE "-Wl,--wrap=native_audio_output_write_pcm"
                        "-Wl,--wrap=native_audio_output_flush_pcm")
  endif()
  if(CYD_OPENETH_RX_BACKOFF)
    cyd_overlay_sdk_source(esp_eth src/openeth/esp_eth_mac_openeth.c
                           prepare-rx-source.py openeth-rx-overlay)
  endif()
  if(CYD_OPENETH_DAC_BOUND_STOP_WAIT AND NOT CYD_OPENETH_DAC_START_ORDER)
    message(FATAL_ERROR "Bounded DAC stop wait requires the DAC start-order experiment")
  endif()
  if(CYD_OPENETH_DAC_START_ORDER)
    if(NOT CONFIG_YORADIO_NATIVE_AUDIO_OUTPUT_DAC)
      message(FATAL_ERROR "DAC start-order experiment requires continuous DAC")
    endif()
    set(dac_options)
    if(CYD_OPENETH_DAC_BOUND_STOP_WAIT)
      list(APPEND dac_options --bound-stop-wait)
    endif()
    cyd_overlay_sdk_source(esp_driver_dac dac_continuous.c
                           prepare-dac-source.py dac-start-overlay ${dac_options})
  endif()
endfunction()

cmake_language(DEFER CALL cyd_attach_openeth_probe)
