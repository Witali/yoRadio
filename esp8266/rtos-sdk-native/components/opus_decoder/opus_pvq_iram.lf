# Diagnostic placement only: code/literals, not rodata, PCM or scratch.
# CMake replaces the generated .s extension, yielding SDK-compatible .c.obj.
# No special selectors/SDK parser changes are needed for either backend.
[mapping:yoradio_opus_pvq_iram]
archive: libopus_decoder.a
entries:
    cwrs:decode_pulses (noflash_text)
    vq:alg_unquant (noflash_text)
