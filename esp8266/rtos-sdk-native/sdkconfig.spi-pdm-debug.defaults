# Overlay on sdkconfig.defaults, applied by build_spi_pdm_debug.ps1.
# Temporary GPIO3/USB-UART isolation test; do not change the board default.
CONFIG_YORADIO_AUDIO_OUTPUT_I2S_PDM=n
CONFIG_YORADIO_AUDIO_OUTPUT_I2S_RCPDM=n
CONFIG_YORADIO_AUDIO_OUTPUT_I2S_PCM=n
CONFIG_YORADIO_AUDIO_OUTPUT_SPI_PDM=y
CONFIG_YORADIO_SPI_PDM_OVERSAMPLE_8=y
