  "modifications": [
    {
      "id": "picolibc-int32-result-local",
      "original": "upstream/libbf.c",
      "original_sha256": "8abc36c9feaeaeb04729e3494c6b693611a518442d11c6546c86bc08b30a1228",
      "modified": "portable/libbf.c",
      "modified_sha256": "158da48780e54571ae2ce56ef7049f9829f62817c005009c9018bdf74d92a378",
      "patch": "portability.patch",
      "occurrences": 1,
      "old": "    return bf_get_int32(pres, a, flags);",
      "new": "    int value;\n    int status = bf_get_int32(&value, a, flags);\n    *pres = value;\n    return status;",
      "reason": "On pinned native picolibc int32_t is long while bf_get_int32 output is int*. Use a real int output, preserve status, then assign to slimb_t without pointer aliasing.",
      "patch_sha256": "cd15a88f0718bb2f18e2b8b269a57983315ef28617b2e836b3bba07391389a42"
    },
    {
      "id": "zero-length-copy-nonnull",
      "original": "upstream/libbf.c",
      "original_sha256": "8abc36c9feaeaeb04729e3494c6b693611a518442d11c6546c86bc08b30a1228",
      "modified": "portable/libbf.c",
      "modified_sha256": "158da48780e54571ae2ce56ef7049f9829f62817c005009c9018bdf74d92a378",
      "patch": "portability.patch",
      "occurrences": 1,
      "old": "    memcpy(r->tab, a->tab, a->len * sizeof(limb_t));",
      "new": "    if (a->len != 0)\n        memcpy(r->tab, a->tab, a->len * sizeof(limb_t));",
      "reason": "Host03 UBSan confirmed zero+zero addition reaches bf_set memcpy(NULL,NULL,0), violating the nonnull C builtin contract; skip exactly the zero-length copy.",
      "patch_sha256": "cd15a88f0718bb2f18e2b8b269a57983315ef28617b2e836b3bba07391389a42"
    }
  ],
