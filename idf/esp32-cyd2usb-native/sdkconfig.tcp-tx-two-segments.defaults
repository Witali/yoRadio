# Optional TCP transmit-queue memory experiment; not board defaults.
# Two 1440-byte segments bound queued WebUI data. Radio reception and TLS
# record capacities are unchanged. Combine with the RX-four-segment overlay
# for the HE-AAC resource comparison; requalify WebUI throughput at real RTT.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
