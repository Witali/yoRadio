# Reproduce the measured radio candidate on the pinned ESP-IDF 6.1 revision.
# Qualification and remaining failures: docs/ESP32C3_PRODUCTION_ACCEPTANCE_20261015.md.
# Quad flash and the fractional divider previously checked on this OLED board.
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_YORADIO_PDM_FRACTIONAL_CLOCK=y

# Recover ordinary SRAM; keep the measured TCP/Wi-Fi ownership policy.
# CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM is not set
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCP_WND_DEFAULT=8640
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
CONFIG_YORADIO_TCP_PCB_POOL=y

# Reserve large TLS RX storage and release completed request-header storage.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_YORADIO_TLS_EARLY_MPI_LOCK=y
CONFIG_YORADIO_TLS_LARGE_BLOCK_RESERVE=y
CONFIG_YORADIO_TLS_RX_ONLY_RESERVE=y
CONFIG_YORADIO_HTTP_RELEASE_REQUEST_BUFFER=y

# Keep a bounded input pool and the measured one-second prefill.
CONFIG_YORADIO_ADAPTIVE_INPUT_BUFFER=y
CONFIG_YORADIO_INPUT_MIN_BLOCKS=5
CONFIG_YORADIO_FLAC_INPUT_EXTRA_SLOTS=4
CONFIG_YORADIO_INPUT_PREFILL_MS=1000
CONFIG_YORADIO_INPUT_PREFILL_MIN_MS=1000

# Qualified frame changes, compact AAC allocation order and packed input tails.
CONFIG_YORADIO_FRAME_ROUTER=y
CONFIG_YORADIO_STREAM_CONFIRM=y
CONFIG_YORADIO_INPUT_TAIL_COALESCE=y
CONFIG_YORADIO_AAC_COMPACT_EARLY_OWNER=y
# Keep the measured bounded capacity and HTTP read policy.
CONFIG_YORADIO_AAC_INPUT_EXTRA_SLOTS=0
CONFIG_YORADIO_STREAM_READ_BYTES=2048
CONFIG_YORADIO_STREAM_READ_TIMEOUT_MS=250
