# Physical qualification candidate; apply after the normal board defaults.
# Preserve full-rate SBR/PS and the existing 16 KiB shared decoder stack.
CONFIG_YORADIO_AAC_PLUS=y
CONFIG_YORADIO_AAC_COMPACT_SBR=y
CONFIG_YORADIO_AAC_HIGH_HISTORY=y
CONFIG_YORADIO_AAC_HIGH_HISTORY_PC19=y
CONFIG_YORADIO_AAC_SMOOTHING_HISTORY=y
CONFIG_YORADIO_AAC_LOW_WORKSPACE=y
CONFIG_YORADIO_AAC_ASYMMETRIC_OWNER=y
CONFIG_YORADIO_AAC_LATE_SBR=y
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=2
# CONFIG_YORADIO_DEEP_SLEEP_CLOCK is not set
