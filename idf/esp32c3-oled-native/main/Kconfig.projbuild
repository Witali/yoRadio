menu "yoRadio ESP32-C3 OLED"

config YORADIO_OLED_HW_SCROLL
    bool "Use SSD1306 hardware text scrolling"
    default y
    help
        Use the SSD1306 horizontal scroll engine for text that fits its
        128-column GDDRAM. Longer text automatically keeps the software
        scrolling path so metadata is never truncated.

choice YORADIO_FLAC_DECODER
    prompt "FLAC decoder implementation"
    default YORADIO_FLAC_DECODER_CUSTOM
    help
        Select the FLAC decoder used by the native audio pipeline. The custom
        decoder reuses yoRadio's O3-optimized, block-sized implementation.
        The Espressif decoder remains available for comparison and fallback.

    config YORADIO_FLAC_DECODER_CUSTOM
        bool "yoRadio custom FLAC (recommended)"

    config YORADIO_FLAC_DECODER_ESPRESSIF
        bool "Espressif esp_audio_codec FLAC"
endchoice

endmenu
