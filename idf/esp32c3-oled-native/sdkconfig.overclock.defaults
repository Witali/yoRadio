# Isolated diagnostic image. The normal firmware remains at the documented
# ESP32-C3 maximum of 160 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# The experiment supplies an RTC watchdog which remains clocked while the CPU
# and BBPLL are deliberately outside their documented configuration.
CONFIG_ESP_TASK_WDT_INIT=n
